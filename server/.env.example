# ---- Server ----
NODE_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173
# Set to true when running behind a hosting platform's proxy (Render, Fly, Railway)
# so the real client IP reaches the rate limiter instead of the proxy's.
TRUST_PROXY=false

# ---- Database (SQLite file; free) ----
DATABASE_FILE=./data/qa.db

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL=12h

# ---- Brevo email alerts (free tier: 300 emails/day) ----
# Leave BREVO_ENABLED=false in dev: alerts are logged to the console instead of sent.
BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=QA Platform

# ---- Google Drive storage (free tier: 15 GB) ----
# Leave GDRIVE_ENABLED=false in dev: uploads are written to LOCAL_UPLOAD_DIR instead.
GDRIVE_ENABLED=false
GDRIVE_CREDENTIALS_FILE=./secrets/gdrive-service-account.json
GDRIVE_CREDENTIALS_JSON=
GDRIVE_FOLDER_ID=
LOCAL_UPLOAD_DIR=./data/uploads
